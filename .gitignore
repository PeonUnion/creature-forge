# ============================================================
# AssetsLab .gitignore
# Grouped by concern. Keep entries that match paths that may be
# regenerated on any branch; drop stale entries for retired assets.
# ============================================================

# --- Environment / toolchain ---
.tools/

# --- Godot project cache ---
prototype/.godot/

# --- Generated / test artifacts (build outputs, never committed) ---
prototype/test_output/
dist/
build/
node_modules/
# 开发环境运行时信息 + 构建的本地二进制（scripts/start-dev.sh）
/.dev/
# 本地 Go 二进制（发布由 CI 产出）
/creature-forge-cli-*
/creature-forge-server-*
# 构建时生成的版本元数据（cf_meta/version.json，打进产物用）
/.cf-meta/

# --- Godot import metadata ---
*.import
# --- OS junk ---
.DS_Store
Thumbs.db

# --- Playwright E2E 输出 ---
creatureforge/web/test-results/
creatureforge/web/playwright-report/

# --- 数据目录（默认仓库根 data/：species 为资产提交；presets 为运行时用户数据） ---
data/presets/
# 向导临时草稿（浏览器/CLI 打开编辑时从正式文件派生，不入库）
data/species/*/draft.json

# --- 测试数据（E2E 用 test-data/，由 e2e/global-setup.mjs 生成，不提交） ---
test-data/
test-data-cli/

# --- CLI/脚本测试输出 ---
test-output/

# --- dev 运行时信息（start-dev.sh 写入：pid/端口/日志） ---
.dev/
